{
  "manifest_version": 3,
  "name": "UINSU Google Scholar Insight",
  "short_name": "Scholar Insight",
  "version": "3.3.3",
  "author": "Muhammad Ikhsan",
  "description": "Peringkat SINTA, Scopus, dan DOAJ serta analitik publikasi di Google Scholar. Dibuat oleh Muhammad Ikhsan, UIN Sumatera Utara Medan.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "https://scholar.google.com/*",
    "https://scholar.google.co.id/*",
    "https://api.crossref.org/*",
    "https://api.openalex.org/*",
    "https://gs-insight.uinsu.ac.id/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "UINSU Google Scholar Insight — buka dasbor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*",
        "https://scholar.google.co.id/citations*"
      ],
      "js": [
        "lib/brand.js",
        "lib/ui.js",
        "lib/analytics.js",
        "content/common.js",
        "content/profile.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scholar.google.com/scholar*",
        "https://scholar.google.co.id/scholar*"
      ],
      "js": [
        "lib/brand.js",
        "lib/ui.js",
        "lib/analytics.js",
        "content/common.js",
        "content/search.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo-uinsu.png"
      ],
      "matches": [
        "https://scholar.google.com/*",
        "https://scholar.google.co.id/*"
      ]
    }
  ]
}
